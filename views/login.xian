<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Geo-Track</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --navy: #0f2044;
            --navy-mid: #1a3260;
            --teal: #0d9488;
            --teal-light: #14b8a6;
            --slate: #64748b;
            --slate-light: #f1f5f9;
            --white: #ffffff;
            --border: #e2e8f0;
            --text: #1e293b;
            --text-muted: #64748b;
            --error: #dc2626;
            --error-bg: #fef2f2;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--slate-light);
            min-height: 100vh;
            display: flex;
        }

        .auth-split {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* Left panel */
        .auth-brand {
            flex: 0 0 42%;
            background: linear-gradient(160deg, var(--navy) 0%, var(--navy-mid) 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 50px;
            color: var(--white);
            position: relative;
            overflow: hidden;
        }

        .auth-brand::before {
            content: '';
            position: absolute;
            bottom: -80px;
            left: -80px;
            width: 380px;
            height: 380px;
            border-radius: 50%;
            background: rgba(13, 148, 136, 0.12);
        }

        .auth-brand::after {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.04);
        }

        .brand-logo {
            width: 72px;
            height: 72px;
            background: var(--teal);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 28px;
            box-shadow: 0 8px 32px rgba(13, 148, 136, 0.4);
            position: relative;
            z-index: 1;
        }

        .brand-name {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
        }

        .brand-tagline {
            font-size: 0.95rem;
            opacity: 0.7;
            text-align: center;
            line-height: 1.6;
            max-width: 280px;
            position: relative;
            z-index: 1;
        }

        .brand-divider {
            width: 40px;
            height: 3px;
            background: var(--teal);
            border-radius: 2px;
            margin: 24px 0;
            position: relative;
            z-index: 1;
        }

        .brand-features {
            list-style: none;
            position: relative;
            z-index: 1;
            margin-top: 8px;
        }

        .brand-features li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.875rem;
            opacity: 0.8;
            padding: 6px 0;
        }

        .brand-features li::before {
            content: '✓';
            width: 20px;
            height: 20px;
            background: rgba(13, 148, 136, 0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            flex-shrink: 0;
        }

        /* Right panel */
        .auth-form-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: var(--white);
        }

        .auth-form-wrapper {
            width: 100%;
            max-width: 420px;
        }

        .auth-form-header {
            margin-bottom: 36px;
        }

        .auth-form-header h2 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
        }

        .auth-form-header p {
            font-size: 0.925rem;
            color: var(--text-muted);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            color: var(--text);
            font-size: 0.875rem;
            font-weight: 500;
        }

        input[type="email"],
        input[type="password"],
        input[type="text"],
        input[type="tel"],
        select,
        textarea {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 0.925rem;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: var(--white);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.12);
        }

        .btn-primary {
            width: 100%;
            padding: 12px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            font-family: 'Inter', sans-serif;
            margin-top: 4px;
        }

        .btn-primary:hover {
            background: var(--teal-light);
            box-shadow: 0 4px 16px rgba(13, 148, 136, 0.3);
            transform: translateY(-1px);
        }

        .auth-links {
            margin-top: 24px;
            text-align: center;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .auth-links a {
            color: var(--teal);
            text-decoration: none;
            font-weight: 500;
        }

        .auth-links a:hover { text-decoration: underline; }

        .auth-links .sep { margin: 0 8px; color: var(--border); }

        .alert {
            padding: 11px 14px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-error {
            background: var(--error-bg);
            color: var(--error);
            border: 1px solid #fecaca;
        }

        @media (max-width: 768px) {
            .auth-brand { display: none; }
            .auth-form-panel { padding: 24px; }
        }
    </style>
</head>
<body>
    <div class="auth-split">
        <div class="auth-brand">
            <div class="brand-logo">🗺️</div>
            <div class="brand-name">Geo-Track</div>
            <div class="brand-tagline">Geographic Information System for the Municipality of Bansud</div>
            <div class="brand-divider"></div>
            <ul class="brand-features">
                <li>Submit geo-tagged service requests</li>
                <li>Real-time status tracking</li>
                <li>Department escalation system</li>
                <li>Barangay-level monitoring</li>
            </ul>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-wrapper">
                <div class="auth-form-header">
                    <h2>Welcome back</h2>
                    <p>Sign in to your Geo-Track account</p>
                </div>

                {{#if error}}
                <div class="alert alert-error">⚠ {{error}}</div>
                {{/if}}

                <form method="POST" action="/login">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>
                    <button type="submit" class="btn-primary">Sign In</button>
                </form>

                <div class="auth-links">
                    <a href="/forgot-password">Forgot password?</a>
                    <span class="sep">|</span>
                    Don't have an account? <a href="/register">Register</a>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
